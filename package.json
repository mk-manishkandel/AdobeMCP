{
  "name": "adobe-mcp",
  "version": "1.2.0",
  "private": true,
  "description": "Local, zero-dependency MCP server that lets Claude design in Adobe Illustrator and Photoshop on macOS: text, shapes, gradients, effects, layers, layer styles, adjustments, filters, background removal and export.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "adobe-illustrator",
    "illustrator",
    "adobe-photoshop",
    "photoshop",
    "extendscript",
    "applescript",
    "macos",
    "design-automation"
  ],
  "homepage": "https://github.com/mk-manishkandel/AdobeMCP#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mk-manishkandel/AdobeMCP.git"
  },
  "bugs": {
    "url": "https://github.com/mk-manishkandel/AdobeMCP/issues"
  },
  "license": "MIT",
  "author": "mk-manishkandel",
  "os": [
    "darwin"
  ],
  "type": "module",
  "main": "server.mjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test \"test/**/*.test.mjs\"",
    "test:coverage": "node --test --experimental-test-coverage \"test/**/*.test.mjs\"",
    "test:live": "node test/live/live.mjs",
    "test:live:ps": "node test/live/live-photoshop.mjs",
    "demo": "node scripts/demo-admission.mjs"
  }
}
